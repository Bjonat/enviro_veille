{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Bjonat/enviro_veille/config/schemas/opportunites.schema.json",
  "title": "Hypothèses d'opportunités professionnelles",
  "type": "object",
  "required": ["generated_at", "based_on_trends", "opportunities"],
  "properties": {
    "generated_at": { "type": "string", "format": "date-time" },
    "based_on_trends": {
      "type": "object",
      "properties": {
        "file": { "type": "string" },
        "period": {
          "type": "object",
          "properties": {
            "start": { "type": "string" },
            "end": { "type": "string" }
          }
        }
      }
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "hypothesis",
          "central_question_answer",
          "need_type",
          "confidence",
          "linked_trends"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "hypothesis": { "type": "string" },
          "central_question_answer": {
            "type": "string",
            "description": "Ce que les pros devront bientôt faire / acheter / mesurer / produire / maîtriser"
          },
          "need_type": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "prestation",
                "logiciel",
                "donnee",
                "expertise",
                "automatisation",
                "formation",
                "outil_methodologique"
              ]
            }
          },
          "buyer_personas": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Ex. bureau d'études, collectivité, exploitant ENR, DREAL…"
          },
          "jobs_to_be_done": {
            "type": "array",
            "items": { "type": "string" }
          },
          "linked_trends": {
            "type": "array",
            "items": { "type": "string" }
          },
          "confidence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "risks_and_unknowns": {
            "type": "array",
            "items": { "type": "string" }
          },
          "validation_questions": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Questions pour l'automation 4"
          }
        }
      }
    }
  }
}
